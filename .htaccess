# Limites d'upload relevées (photos volumineuses) — pour Apache/XAMPP (mod_php)
<IfModule mod_php.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 55M
    php_value memory_limit 256M
    php_value max_file_uploads 20
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 55M
    php_value memory_limit 256M
    php_value max_file_uploads 20
</IfModule>
